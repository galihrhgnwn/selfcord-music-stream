# Discord account token (selfbot). When set here, config.json can leave "token" empty.
DISCORD_TOKEN=

# Spotify Web API (client credentials): song search and metadata.
# Create an app at https://developer.spotify.com/dashboard and copy the Client ID and Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# AI for w/help <question>. The endpoint must be OpenAI-compatible
# (POST {AI_API_URL}/chat/completions with an Authorization header).
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional: path to the yt-dlp binary when it is not on PATH.
YTDLP_PATH=
